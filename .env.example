# ============================================================================
# MODELLO per .env
#
# Copiare in .env (stessa cartella, senza .example) e valorizzare JWT_SECRET.
# Docker Compose legge .env automaticamente: da quel momento basta
#
#     docker compose up --build
#
# senza passare variabili sulla riga di comando.
#
# .env e' ignorato da git. Questo modello no, ed e' per questo che non contiene
# nessun valore reale.
# ============================================================================

# OBBLIGATORIA, senza default di proposito: un segreto con un valore di comodo
# finirebbe prima o poi in produzione. Generarla con:
#     openssl rand -base64 48
#
# Vanno bene entrambi gli alfabeti base64, standard ('+' e '/') o url-safe ('-' e '_'):
# il codice normalizza prima di decodificare. Non e' sempre stato cosi' - il comando qui
# sopra produce base64 standard mentre il codice decodificava in url-safe, e un segreto
# con dentro una '/' faceva morire tre servizi all'avvio.
# Deve restare STABILE fra un avvio e l'altro: cambiarla invalida tutti i token
# gia' emessi, e chi era autenticato si ritrova con un 401 senza motivo apparente.
JWT_SECRET=


# Password del PostgreSQL LOCALE, quello usato dai servizi avviati a mano con
# "mvn spring-boot:run". E' un valore diverso da DB_PASSWORD qui sotto, che riguarda
# invece i PostgreSQL dentro i container.
#
# Spring la riconosce per convenzione: SPRING_DATASOURCE_PASSWORD diventa
# spring.datasource.password. Vale lo stesso per JWT_SECRET -> jwt.secret.
#
# Verificato che l'ambiente abbia la precedenza su config/config.properties: quel file
# resta come riserva, ma se questa variabile e' valorizzata e' questa a vincere.
SPRING_DATASOURCE_PASSWORD=

# Le seguenti hanno un default utilizzabile in sviluppo e vanno cambiate altrove.
# Password dei PostgreSQL nei container, non quella del database locale.
DB_PASSWORD=postgres
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Origini ammesse dal gateway. Il default copre i due server di sviluppo piu' comuni.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
