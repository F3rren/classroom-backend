# ============================================================================
# MODELLO per .env
#
# Copiare in .env (stessa cartella, senza .example) e valorizzare JWT_SECRET.
# Da quel momento basta
#
#     docker compose up --build
#
# senza passare variabili sulla riga di comando.
#
# .env e' l'UNICO posto dove stanno i segreti, e lo leggono in due:
#   - Docker Compose, che lo trova da solo e inietta i valori nei container;
#   - Spring, tramite spring.config.import nei tre application.properties, per i
#     servizi lanciati fuori dai container.
#
# .env e' ignorato da git. Questo modello no, ed e' per questo che non contiene
# nessun valore reale.
#
# ----------------------------------------------------------------------------
# UN VINCOLO DI FORMATO, e non e' pignoleria
#
# I due lettori non interpretano i valori allo stesso modo:
#
#     X="ciao"     Compose legge  ciao        Java legge  "ciao"
#     X=a\bc       Compose legge  a\bc        Java legge  abc
#
# Quindi: NIENTE VIRGOLETTE e niente backslash attorno ai valori. Violarlo non
# produce un errore: produce due letture diverse DELLO STESSO FILE, con un file
# che a guardarlo sembra giusto. Il sintomo sarebbe un token che non valida, e
# nulla a indicare la causa.
#
# I segreti base64 non contengono ne' virgolette ne' backslash, quindi seguendo
# le istruzioni qui sotto il caso non si presenta. Il vincolo e' fissato dai
# test in shared/src/test/java/com/prenotazioni/setting/FormatoEnvUnitTest.java
# ============================================================================

# OBBLIGATORIA, senza default di proposito: un segreto con un valore di comodo
# finirebbe prima o poi in produzione. Generarla con:
#     openssl rand -base64 48
#
# Vanno bene entrambi gli alfabeti base64, standard ('+' e '/') o url-safe ('-' e '_'):
# il codice normalizza prima di decodificare. Non e' sempre stato cosi' - il comando qui
# sopra produce base64 standard mentre il codice decodificava in url-safe, e un segreto
# con dentro una '/' faceva morire tre servizi all'avvio.
# Deve restare STABILE fra un avvio e l'altro: cambiarla invalida tutti i token
# gia' emessi, e chi era autenticato si ritrova con un 401 senza motivo apparente.
JWT_SECRET=


# Password del PostgreSQL LOCALE, quello usato dai servizi avviati a mano con
# "mvn spring-boot:run". E' un valore diverso da DB_PASSWORD qui sotto, che riguarda
# invece i PostgreSQL dentro i container.
#
# ATTENZIONE al nome: la conversione SPRING_DATASOURCE_PASSWORD -> spring.datasource.password
# e' automatica solo per le VARIABILI D'AMBIENTE vere, cioe' dentro i container. Per le
# chiavi lette da questo file NON avviene, ed e' per questo che ogni application.properties
# dichiara il ponte esplicito:
#     spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:}
# Aggiungere qui una variabile nuova senza il ponte corrispondente significa scriverla e
# non vederla mai usata.
SPRING_DATASOURCE_PASSWORD=


# ----------------------------------------------------------------------------
# PRIMO AMMINISTRATORE
#
# Servono solo su un database utenti VUOTO. /api/admin/utenti richiede un token da
# amministratore, quindi senza queste il primo amministratore andrebbe inserito a mano nel
# database - a ogni ambiente nuovo, e con l'hash della password calcolato fuori.
#
# Se valorizzate, all'avvio di auth-service e SOLO se la tabella utenti e' vuota viene
# creato un amministratore con queste credenziali. A tabella non vuota il meccanismo e'
# inerte: non promuove e non aggiorna nessuno.
#
# Vanno svuotate dopo il primo accesso, insieme al cambio della password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Facoltativa, il default e' "Amministratore".
BOOTSTRAP_ADMIN_NOME=


# Le seguenti hanno un default utilizzabile in sviluppo e vanno cambiate altrove.
# Password dei PostgreSQL nei container, non quella del database locale.
DB_PASSWORD=postgres
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Origini ammesse dal gateway. Il default copre i due server di sviluppo piu' comuni.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
