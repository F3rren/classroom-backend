# ============================================================================
# THE TEMPLATE for .env
#
# Copy it to .env (same folder, without .example) and fill in JWT_SECRET.
# From then on
#
#     docker compose up --build
#
# is enough, with no variables on the command line.
#
# .env is the ONLY place the secrets live, and two things read it:
#   - Docker Compose, which finds it on its own and injects the values into the containers;
#   - Spring, through spring.config.import in the three application.properties, for the
#     services launched outside the containers.
#
# .env is ignored by git. This template is not, which is why it holds no real value.
#
# ----------------------------------------------------------------------------
# ONE CONSTRAINT ON THE FORMAT, and it is not pedantry
#
# The two readers do not interpret the values the same way:
#
#     X="hello"    Compose reads  hello       Java reads  "hello"
#     X=a\bc       Compose reads  a\bc        Java reads  abc
#
# So: NO QUOTES and no backslashes around the values. Breaking that produces no error: it
# produces two different readings OF THE SAME FILE, from a file that looks right. The symptom
# would be a token that does not validate, with nothing to point at the cause.
#
# Base64 secrets contain neither quotes nor backslashes, so following the instructions below
# the case never arises. The constraint is pinned by EnvFormatUnitTest in shared.
# ============================================================================

# MANDATORY, with no default on purpose: a secret with a convenience value ends up in
# production sooner or later. Generate one with:
#     openssl rand -base64 48
#
# Either base64 alphabet is fine, standard ('+' and '/') or url-safe ('-' and '_'): the code
# normalises before decoding. It was not always so - the command above produces standard
# base64 while the code decoded as url-safe, and a secret with a '/' in it killed three
# services at startup.
#
# It has to stay STABLE between restarts: changing it invalidates every token already issued,
# and whoever was logged in gets a 401 for no apparent reason.
JWT_SECRET=


# The password of the LOCAL PostgreSQL, the one used by services started by hand with
# "mvn spring-boot:run". It is a different value from DB_PASSWORD below, which concerns the
# PostgreSQL instances inside the containers.
#
# MIND THE NAME: the conversion SPRING_DATASOURCE_PASSWORD -> spring.datasource.password is
# automatic only for real ENVIRONMENT VARIABLES, that is, inside the containers. For keys
# read from this file it does NOT happen, which is why every application.properties declares
# the bridge explicitly:
#     spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:}
# Adding a new variable here without the matching bridge means writing it and never seeing it
# used.
SPRING_DATASOURCE_PASSWORD=


# ----------------------------------------------------------------------------
# THE FIRST ADMINISTRATOR
#
# These are only needed on an EMPTY users database. /api/admin/users requires an
# administrator token, so without them the first administrator would have to be inserted into
# the database by hand - in every new environment, with the password hash computed elsewhere.
#
# If they are set, then at auth-service startup, and ONLY if the users table is empty, an
# administrator is created with these credentials. On a non-empty table the mechanism is
# inert: it promotes nobody and updates nobody.
#
# They should be emptied after the first login, along with changing the password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional, the default is "Amministratore".
BOOTSTRAP_ADMIN_NAME=


# The following have a usable development default, and in production they BECOME MANDATORY.
# Not out of discipline: because a convenient default travels elsewhere silently, and a
# database reachable with the password "postgres" gives no signal at all until it is somebody
# else's problem.
#
# What enforces it is docker-compose.prod.yml, where the same variables take the ${...:?}
# form:
#
#     docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# If one is missing, compose refuses to start and says which. In development, without that
# file, the defaults below still apply and nothing changes.
# The password of the PostgreSQL instances in the containers, not of the local database.
DB_PASSWORD=postgres
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# The origins the gateway admits. The default covers the two most common development servers.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
