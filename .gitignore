# ============================================
# SENSITIVE CONFIGURATION (IMPORTANT!)
# ============================================
# The compose stack's environment variables: this file holds JWT_SECRET and the services'
# passwords. Docker Compose reads it on its own, which is very convenient - and is exactly
# why it has to stay out of git. The versioned template is .env.example.
.env
.env.local

# Personal, temporary Docker Compose overrides - e.g. SPRING_PROFILES_ACTIVE=dev to inspect
# Swagger through Docker. Compose merges it automatically on top of docker-compose.yml, which
# is convenient for the same reason it must stay out of git: committing it would turn one
# person's local override into everybody's default.
docker-compose.override.yml

# Environment-specific configuration files.
# The generic rules stay as a safety net for stray copies outside the project.
**/application-local.properties
**/application-dev.properties
**/application-prod.properties

# ...but the project's two versioned profiles have to be committed: they hold ONLY
# non-sensitive values (urls, ports, log levels, CORS origins). The secrets stay in
# .env, ignored just above.
# Without these two negations the files would be ignored in silence: no error, they
# simply would never reach a commit, and production would start from a jar that does
# not contain them.
# The negations are deliberately generic (**/ rather than the exact path): with the
# multi-module layout the path went from src/ to app/src/, and it will change again when
# the services are separated. Anchoring them to the path would make them expire silently.
!**/src/main/resources/application-dev.properties
!**/src/main/resources/application-prod.properties

