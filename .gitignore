# ============================================
# CONFIGURAZIONI SENSIBILI (IMPORTANTE!)
# ============================================
# File con credenziali database e altre configurazioni sensibili
config/config.properties

# Variabili d'ambiente dello stack compose: contiene JWT_SECRET e le password dei
# servizi. Docker Compose legge questo file da solo, quindi e' comodissimo - ed e'
# esattamente per questo che va tenuto fuori da git. Il modello versionato e' .env.example.
.env
.env.local

# File di configurazione ambiente-specifici.
# Le regole generiche restano come rete di sicurezza per copie sparse fuori dal progetto.
**/application-local.properties
**/application-dev.properties
**/application-prod.properties

# ...ma i due profili versionati del progetto vanno committati: contengono SOLO
# valori non sensibili (url, porte, livelli di log, origini CORS). I segreti restano
# in config/config.properties, ignorato qui sopra.
# Senza queste due negazioni i file verrebbero ignorati in silenzio: nessun errore,
# semplicemente non finirebbero mai in un commit e la produzione partirebbe da un
# jar che non li contiene.
# Le negazioni sono deliberatamente generiche (**/ invece del percorso esatto): con la
# struttura multi-modulo il percorso e' passato da src/ ad app/src/, e cambiera' ancora
# quando i servizi verranno separati. Ancorarle al percorso le farebbe scadere in silenzio.
!**/src/main/resources/application-dev.properties
!**/src/main/resources/application-prod.properties

