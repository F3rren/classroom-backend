<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.prenotazioni</groupId>
    <artifactId>prenotazioni-aule-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>PrenotazioniAuleBackend</name>
    <description>Backend Spring Boot per prenotazione aule</description>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>
    <properties>
        <java.version>17</java.version>
        <!-- Non gestita da spring-boot-starter-parent: va fissata esplicitamente -->
        <jacoco.version>0.8.12</jacoco.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Migrazioni versionate dello schema. Prima lo schema reale era quello
             generato da ddl-auto=update e i file .sql del progetto non venivano
             mai eseguiti, con la conseguenza che i vincoli di dominio mancavano. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.3</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.40</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-logging</artifactId>
        </dependency>
        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Testcontainers: una sola classe di test gira su PostgreSQL reale, per coprire
            cio' che H2 non sa esprimere (EXCLUDE USING gist, CHECK constraint, migrazioni
            Flyway). Le altre 9 classi di integrazione restano su H2, veloci.

            Nessun <version>: la 1.19.8 e' gia' gestita da spring-boot-dependencies, e
            fissarla qui la farebbe divergere al prossimo aggiornamento di Spring Boot.

            junit:junit (JUnit 4) arriva transitivo e NON va escluso: PostgreSQLContainer
            eredita da una gerarchia che implementa org.junit.rules.TestRule, quindi serve
            a compile-time anche se i test sono tutti su JUnit 5.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                api.version e' letto da docker-java (dentro Testcontainers) e fissa la
                versione di API Docker usata per parlare col daemon.

                Serve: docker-java negozia di default la 1.32, mentre Docker Engine 29.x
                dichiara MinAPIVersion 1.40 e risponde 400 Bad Request. Testcontainers
                interpreta il 400 come "daemon assente", segna la classe come skipped e la
                build resta verde senza aver provato nulla. Non e' un problema di pipe ne'
                di versione di Testcontainers: la 1.21.3 fallisce esattamente allo stesso
                modo, ed e' stata scartata proprio per questo.

                1.40 e non 1.44: e' il minimo accettato dall'Engine 29 ed e' supportata
                gia' da Engine 19.03, quindi copre la banda piu' ampia di daemon.

                ATTENZIONE: non aggiungere qui un <argLine>. La property "argLine" e'
                impostata da jacoco:prepare-agent; sovrascriverla senza @{argLine} manda
                la copertura a zero in silenzio. systemPropertyVariables non la tocca.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <api.version>1.40</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!--
                Copertura test. NOTA: prepare-agent imposta la property "argLine" usata da
                surefire. Se in futuro si aggiunge una <configuration><argLine> a surefire,
                DEVE contenere @{argLine} o la copertura scende silenziosamente a 0.

                report gira in fase "test" (comodo per il ciclo di sviluppo: mvn test genera
                gia' target/site/jacoco/index.html), mentre il gate all'80% gira in fase
                "verify": cosi' "mvn test" resta verde mentre si lavora e "mvn verify" e' il
                comando che fa fallire la build sotto soglia.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <!-- Solo la classe @SpringBootApplication: il main() non e' testabile
                             in modo significativo. Volutamente NON si escludono i dto: quelle
                             righe sono gia' quasi tutte coperte (Jackson invoca i getter
                             serializzando), quindi escluderle abbasserebbe la percentuale. -->
                        <exclude>com/prenotazioni/PrenotazioniAuleBackendApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check-line-80</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
