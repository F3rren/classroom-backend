<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.classroom</groupId>
    <artifactId>classroom-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Classroom (aggregator)</name>
    <description>The module aggregator: shared and the four services</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <!--
        The first step of breaking the monolith into services: the layout became
        multi-module while the deployable stayed single. It was there to make the boundaries
        checkable by the compiler before introducing the network: if a module compiles while
        declaring dependencies only on shared, the boundary is real; if it does not compile,
        it was imaginary.
    -->
    <modules>
        <module>shared</module>
        <module>services/notification-service</module>
        <module>services/auth-service</module>
        <module>services/booking-service</module>
        <module>services/gateway</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <!-- Not managed by spring-boot-starter-parent: it has to be pinned explicitly -->
        <jacoco.version>0.8.12</jacoco.version>
        <lombok.version>1.18.40</lombok.version>
        <jjwt.version>0.12.3</jjwt.version>
        <springdoc.version>2.6.0</springdoc.version>
        <!-- The coverage gate's threshold. Modules may override it: the denominator changes from
             module to module, so one single threshold is not automatically sensible.

             WITHOUT DOCKER THIS GATE FAILS, and it is right that it should. The
             @Testcontainers classes skip themselves when Docker is absent (skipped, not an
             error), but the code they covered stays uncovered: notification-service drops to
             0.67 because CancellationMessagingTest is the only thing exercising the AMQP
             topology. The gate certifies that the code has been tested, and it cannot certify
             what never ran.

             Maven's message, though, says only "Coverage checks have not been met", without
             naming Docker: whoever lands on it goes looking for missing tests that are not
             missing. For the development cycle without Docker use "mvn test", which passes;
             "mvn verify" requires Docker to be up. It is written in the README too. -->
        <jacoco.line.minimum>0.80</jacoco.line.minimum>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
                "mvn spring-boot:run -pl booking-service -am" applies the goal to every
                project in the reactor, the aggregator and shared included, neither of which
                has a main class and both of which would fail the command. Here the goal
                becomes a no-op; each service re-enables it explicitly.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <!--
                    api.version is read by docker-java (inside Testcontainers) and pins the
                    Docker API version used to talk to the daemon.

                    It is needed: docker-java negotiates 1.32 by default, while Docker Engine
                    29.x declares MinAPIVersion 1.40 and answers 400 Bad Request.
                    Testcontainers reads that 400 as "no daemon", marks the class as skipped,
                    and the build stays green having proved nothing. It is not a pipe problem
                    nor a Testcontainers version problem: 1.21.3 fails the same way.

                    1.40 and not 1.44: it is the minimum Engine 29 accepts and has been
                    supported since Engine 19.03, so it covers the widest band of daemons.

                    It sits in pluginManagement because it applies to every module hosting
                    Testcontainers tests.

                    CAREFUL: do not add an <argLine> here. The "argLine" property is set by
                    jacoco:prepare-agent; overwriting it without @{argLine} sends coverage to
                    zero in silence. systemPropertyVariables does not touch it.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <api.version>1.40</api.version>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <!--
                    Test coverage. report runs in the "test" phase (so mvn test already
                    produces target/site/jacoco/index.html), and the gate runs in "verify":
                    mvn test stays green while you work, and mvn verify is what fails below
                    the threshold.
                -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>jacoco-prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-check-line</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${jacoco.line.minimum}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
