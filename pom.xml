<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.prenotazioni</groupId>
    <artifactId>prenotazioni-aule-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>PrenotazioniAule (aggregatore)</name>
    <description>Aggregatore dei moduli: shared e applicazione</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <!--
        Primo passo della scomposizione in microservizi: la struttura diventa multi-modulo
        ma il deployable resta uno solo (app). Serve a rendere i confini verificabili dal
        compilatore prima di introdurre la rete: se un modulo compila dichiarando dipendenze
        solo verso shared, il confine e' reale; se non compila, era immaginario.
    -->
    <modules>
        <module>shared</module>
        <module>services/notifica-service</module>
        <module>services/auth-service</module>
        <module>services/prenotazione-service</module>
        <module>services/gateway</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <!-- Non gestita da spring-boot-starter-parent: va fissata esplicitamente -->
        <jacoco.version>0.8.12</jacoco.version>
        <lombok.version>1.18.40</lombok.version>
        <jjwt.version>0.12.3</jjwt.version>
        <springdoc.version>2.6.0</springdoc.version>
        <!-- Soglia del gate di copertura. I moduli possono sovrascriverla: il denominatore
             cambia da modulo a modulo, quindi una soglia unica non e' automaticamente sensata. -->
        <jacoco.line.minimum>0.80</jacoco.line.minimum>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
                "mvn spring-boot:run -pl prenotazione-service -am" applica il goal a ogni progetto del
                reattore, aggregatore e shared inclusi, che non hanno una main class e
                farebbero fallire il comando. Qui il goal diventa un no-op; app lo
                riabilita esplicitamente.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <!--
                    api.version e' letto da docker-java (dentro Testcontainers) e fissa la
                    versione di API Docker usata per parlare col daemon.

                    Serve: docker-java negozia di default la 1.32, mentre Docker Engine 29.x
                    dichiara MinAPIVersion 1.40 e risponde 400 Bad Request. Testcontainers
                    interpreta il 400 come "daemon assente", segna la classe come skipped e la
                    build resta verde senza aver provato nulla. Non e' un problema di pipe ne'
                    di versione di Testcontainers: la 1.21.3 fallisce allo stesso modo.

                    1.40 e non 1.44: e' il minimo accettato dall'Engine 29 ed e' supportata
                    gia' da Engine 19.03, quindi copre la banda piu' ampia di daemon.

                    Sta in pluginManagement perche' vale per ogni modulo che ospiti test
                    Testcontainers: oggi solo app, domani prenotazione-service.

                    ATTENZIONE: non aggiungere qui un <argLine>. La property "argLine" e'
                    impostata da jacoco:prepare-agent; sovrascriverla senza @{argLine} manda
                    la copertura a zero in silenzio. systemPropertyVariables non la tocca.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <api.version>1.40</api.version>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <!--
                    Copertura test. report gira in fase "test" (cosi' mvn test genera gia'
                    target/site/jacoco/index.html), il gate gira in fase "verify": mvn test
                    resta verde mentre si lavora, mvn verify e' cio' che fallisce sotto soglia.
                -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>jacoco-prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-check-line</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${jacoco.line.minimum}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
